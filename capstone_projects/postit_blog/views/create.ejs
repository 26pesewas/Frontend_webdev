<%-include("partials/header.ejs")%>
    <main class="container">
        <div class = "form-card">
        <h1>Your Post</h1>
        
        <form action="/view" method="POST" class="blog-form">
            
            <div class="form-group">
                <label for="title">Post Title</label>
                <input type="text" id="title" name="blogTitle" placeholder="Enter a catchy title..." value = "<%= locals.existingTitle ? existingTitle : '' %>" required>
            </div>

            <div class="form-group">
                <label for="content">Content</label>
                <textarea id="content" name="blogContent" rows="10" required><%= locals.existingContent ? existingContent : '' %></textarea>
            </div>

            <button type="submit" class="btn-main">View Post</button>
        </form>
        </div>
    </main>

<%-include("partials/footer.ejs")%>