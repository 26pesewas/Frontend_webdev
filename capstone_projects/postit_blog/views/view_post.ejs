<%-include("partials/header.ejs")%>

<main class="container">
    <div class = "post-detail-card">
    <% if((locals.blogTitle) && (locals.blogContent)){ %>
        <article>
            <h1 class="post-body"><%= blogTitle %></h1>
            <hr>
            <div class="post-body">
                <p><%= blogContent %></p>
            </div>
        </article>


        <div class="action-buttons">
        <form action="/edit" method="POST">
            <input type="hidden" name="blogTitle" value="<%= blogTitle %>">
            <input type="hidden" name="blogContent" value="<%= blogContent %>">
            <button type="submit" class="btn-edit">Edit Post</button>
        </form>
        <form action="/delete" method="POST">
            <input type="hidden" name="blogTitle" value="<%= blogTitle %>">
            <input type="hidden" name="blogContent" value="<%= blogContent %>">
            <button type="submit" class="btn-delete">Delete Post</button>
        </form>
        </div>
   <% } else{ %>
    <div class="error-msg">
     <%- include("index.ejs") %>
    <% } %>
    </div>
    </div>
</main>
<%-include("partials/footer.ejs")%>
